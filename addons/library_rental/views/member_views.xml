<odoo>
    <record id="view_library_member_tree" model="ir.ui.view">
        <field name="name">library.member.tree</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="membership_number"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="membership_number"/>
                        <field name="email"/>
                        <field name="phone"/>
                <field name="user_id"/>
                    </group>
                    <notebook>
                        <page string="Видачі">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="copy_id"/>
                                    <field name="book_id"/>
                                    <field name="loan_date"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Читачі</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
