<odoo>
    <record id="view_library_copy_tree" model="ir.ui.view">
        <field name="name">library.copy.tree</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <list>
                <field name="inventory_number"/>
                <field name="book_id"/>
                <field name="condition"/>
            </list>
        </field>
    </record>
    <record id="view_library_copy_form" model="ir.ui.view">
        <field name="name">library.copy.form</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="book_id"/>
                        <field name="inventory_number"/>
                        <field name="condition"/>
                    </group>
                    <notebook>
                        <page string="Історія видач">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="member_id"/>
                                    <field name="loan_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_library_copy" model="ir.actions.act_window">
        <field name="name">Примірники</field>
        <field name="res_model">library.copy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
